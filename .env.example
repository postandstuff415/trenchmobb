# Solana RPC with getProgramAccounts enabled (Helius, Triton, QuickNode...). The public RPC will not work.
VITE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Kamino lending market that holds the meme-coin reserves (lenders supply memes, shorters borrow them).
# Main market shown as a placeholder; you will most likely create your own isolated market.
VITE_KLEND_MARKET=7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF

# Collateral shorters post, and the token borrowed memes are sold into (USDC).
VITE_COLLATERAL_MINT=EPjFWWd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Optional comma-separated allowlist of shortable mints. Empty = every borrowable reserve except the collateral.
VITE_SHORTABLE_MINTS=

# Platform fee: SOL transferred to FEE_WALLET inside the same transaction that opens the short.
VITE_FEE_WALLET=YOUR_TREASURY_WALLET_ADDRESS
VITE_FEE_SOL=0.01

# Jupiter swap API (set VITE_JUP_API_KEY if you use the keyed api.jup.ag endpoint)
VITE_JUP_API=https://lite-api.jup.ag/swap/v1
VITE_JUP_API_KEY=
VITE_SLIPPAGE_BPS=100

# Priority fee in micro-lamports per compute unit
VITE_PRIORITY_MICROLAMPORTS=50000
